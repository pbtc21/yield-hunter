{
  "name": "@aibtc/yield-hunter",
  "version": "0.1.0",
  "description": "Autonomous sBTC yield farming agent - One command to earn Bitcoin yield",
  "type": "module",
  "bin": {
    "yield-hunter": "./bin/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/cli.ts ./src/index.ts --outdir ./dist --target node",
    "start": "bun run ./src/cli.ts",
    "dev": "bun run --watch ./src/cli.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "scan": "bun run src/yield-hunter/scanning/scan-pools.ts",
    "hunt": "bun run src/yield-hunter/execution/hunt-yield.ts",
    "birth": "bun run src/yield-hunter/lifecycle/birth-hunter.ts",
    "agent": "bun run scripts/run-agent.ts",
    "autonomous": "bun run scripts/run-autonomous.ts",
    "test:x402": "bun run scripts/test-x402.ts",
    "test:api": "bun test tests/api.test.ts",
    "test:agent": "bun test tests/agent.test.ts",
    "test:all": "bun test tests/api.test.ts tests/agent.test.ts",
    "deploy": "bun run scripts/deploy.ts",
    "check": "clarinet check",
    "test": "clarinet test",
    "deploy:contracts": "bun run scripts/deploy.ts",
    "deploy:leaderboard": "bun run wrangler deploy --config wrangler.leaderboard.toml",
    "dev:leaderboard": "bun run wrangler dev --config wrangler.leaderboard.toml",
    "deploy:x402": "bun run wrangler deploy --config wrangler.x402.toml",
    "dev:x402": "bun run wrangler dev --config wrangler.x402.toml",
    "mcp": "bun run src/mcp/server.ts",
    "console": "clarinet console"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@stacks/network": "^6.13.0",
    "@stacks/transactions": "^6.13.0",
    "@stacks/wallet-sdk": "^6.0.0",
    "@faktoryfun/styx-sdk": "^1.3.5",
    "@stacks/connect": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "hono": "^4.0.0",
    "sats-connect": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/bun": "^1.0.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aibtcdev/yield-hunter"
  },
  "keywords": [
    "bitcoin",
    "stacks",
    "defi",
    "yield",
    "ai",
    "agent",
    "sbtc",
    "zest"
  ],
  "author": "AIBTC <dev@aibtc.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ]
}
